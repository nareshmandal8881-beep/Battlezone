{
  "appId": "com.battle",
  "appName": "BattleZone",
  "webDir": "build",
  "server": {
    "url": "https://battlezone-51952.web.app/app.html",
    "allowNavigation": [
      "battlezone-51952.web.app",
      "battlezone-51952.firebaseapp.com"
    ],
    "androidScheme": "https"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    },
    "SplashScreen": {
      "launchShowDuration": 4000,
      "launchAutoHide": true,
      "backgroundColor": "#000000",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#000000",
      "overlaysWebView": false
    }
  },
  "backgroundColor": "#000000"
}
