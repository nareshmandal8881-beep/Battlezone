rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Owner emails are always admin (an email can only belong to one Firebase account).
    // Must match OWNER_EMAILS in src/lib/admin.js.
    function isOwner() {
      return signedIn() && request.auth.token.email in ['naftieshmandal02@gmail.com'];
    }
    function isAdmin() {
      return isOwner() || (signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Player profiles: public for the leaderboard; you can edit your own,
    // but you cannot make yourself admin or change your stats.
    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'player';
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'wins', 'kills', 'totalEarnings']));
      allow delete: if isAdmin();
    }

    // Tournaments: everyone can read; only admins write,
    // except a signed-in player adding themselves to registeredPlayers.
    match /tournaments/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredPlayers']) &&
        request.resource.data.registeredPlayers.hasAll(resource.data.registeredPlayers) &&
        request.resource.data.registeredPlayers.size() == resource.data.registeredPlayers.size() + 1 &&
        request.auth.uid in request.resource.data.registeredPlayers);
    }

    // Game catalogue managed by admins; published ones show in the app.
    match /games/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Announcements sent by admins; everyone can read them.
    match /notifications/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /payments/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Online Ludo rooms: anyone logged in can look up a room by code;
    // only seated players can change it, and a new player can only add themselves while it's waiting.
    match /ludoRooms/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.host == request.auth.uid
        && request.resource.data.uids == [request.auth.uid];
      allow update: if signedIn()
        && (request.auth.uid in resource.data.uids
          || (resource.data.status == 'waiting'
            && request.auth.uid in request.resource.data.uids
            && request.resource.data.uids.size() == resource.data.uids.size() + 1
            && request.resource.data.uids.size() <= resource.data.maxPlayers));
      allow delete: if signedIn() && (resource.data.host == request.auth.uid || isAdmin());

      match /chat/{msgId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 80
          && request.auth.uid in get(/databases/$(database)/documents/ludoRooms/$(code)).data.uids;
      }
    }

    // Older 2-player lobby (GameLobby.jsx, no longer linked from the app)
    match /gameRooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.player1.uid == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.player1.uid == request.auth.uid
          || resource.data.player2 == null
          || resource.data.player2.uid == request.auth.uid);
      allow delete: if signedIn() && resource.data.player1.uid == request.auth.uid;
    }
  }
}
