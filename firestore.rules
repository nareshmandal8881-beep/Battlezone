rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Owner emails are always admin (an email can only belong to one Firebase account).
    function isOwner() {
      return signedIn() && request.auth.token.email in ['naftieshmandal02@gmail.com'];
    }
    function isAdmin() {
      return isOwner() || (signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Player profiles: public for the leaderboard; you can edit your own,
    // but you cannot make yourself admin or change your stats.
    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'player';
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'wins', 'kills', 'totalEarnings']));
      allow delete: if isAdmin();
    }

    // Tournaments: everyone can read; only admins write,
    // except a signed-in player adding themselves to registeredPlayers.
    match /tournaments/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredPlayers']) &&
        request.resource.data.registeredPlayers.hasAll(resource.data.registeredPlayers) &&
        request.resource.data.registeredPlayers.size() == resource.data.registeredPlayers.size() + 1 &&
        request.auth.uid in request.resource.data.registeredPlayers);
    }

    // Game catalogue managed by admins; published ones show in the app.
    match /games/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /payments/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
