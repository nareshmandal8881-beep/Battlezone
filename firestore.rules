rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // Tournaments
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
    }

    // Online Ludo rooms: anyone logged in can look up a room by code;
    // only seated players can change it, and a new player can only add themselves while it's waiting.
    match /ludoRooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.host == request.auth.uid
        && request.resource.data.uids == [request.auth.uid];
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.uids
          || (resource.data.status == 'waiting'
            && request.auth.uid in request.resource.data.uids
            && request.resource.data.uids.size() == resource.data.uids.size() + 1
            && request.resource.data.uids.size() <= resource.data.maxPlayers));
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;

      match /chat/{msgId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 80
          && request.auth.uid in get(/databases/$(database)/documents/ludoRooms/$(code)).data.uids;
      }
    }

    // 🎮 Game Rooms — Room ID system
    match /gameRooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.player1.uid == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.player1.uid == request.auth.uid
          || resource.data.player2 == null
          || resource.data.player2.uid == request.auth.uid);
      allow delete: if request.auth != null
        && resource.data.player1.uid == request.auth.uid;
    }
  }
}
